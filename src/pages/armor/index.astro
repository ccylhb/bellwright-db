---
const SITE = Astro.site?.origin ?? "";
import Base from "../../layouts/Base.astro";
import DataTable from "../../components/DataTable.astro";
import Related from "../../components/Related.astro";
import armor from "../../data/bellwright_armor.json";

const n = (v) => {
  const m = String(v ?? "").match(/-?\d+(?:\.\d+)?/);
  return m ? parseFloat(m[0]) : "";
};
const rows = armor
  .map((x) => ({
    name: `<a href="/armor/${x.slug}/">${x.title}</a>${x.icon_file ? ` <img src="/icons/${x.icon_file}" alt="" width="22" height="22" style="vertical-align:middle" loading="lazy" />` : ""}`,
    _sort: x.title.toLowerCase(),
    slot: (x.fields?.slot || "").slice(0, 16),
    armor: n(x.fields?.armor),
    speed: (x.fields?.speed || "").slice(0, 12),
    categ: (x.fields?.categ || "").slice(0, 18),
  }))
  .sort((a, b) => a._sort.localeCompare(b._sort));
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
      { "@type": "ListItem", position: 2, name: "Armor", item: SITE + "/armor/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Armor",
    mainEntityOfPage: SITE + "/armor/",
  },
];

---
<Base
  title="Bellwright Armor & Clothing — ${armor.length} entries with exact values"
  description="armor ratings, speed penalties and slots for ${armor.length} Bellwright armor & clothing."
>
  <h1>Armor & Clothing</h1>
  <p class="muted">${armor.length} entries · click a column to sort.</p>
  <DataTable
    id="armor"
    rows={rows}
    searchPlaceholder="Search armor & clothing..."
    columns={[
      { key: "name", label: "Piece" },
      { key: "slot", label: "Slot" },
      { key: "armor", label: "Armor", type: "number" },
      { key: "speed", label: "Speed" },
      { key: "categ", label: "Category" },
    ]}
  />
  <Related
    links={[
      { href: "/loadout-builder/", title: "Loadout Builder", sub: "Build your armor set", tool: true },
      { href: "/weapons/", title: "Weapons", sub: "Damage values" },
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
