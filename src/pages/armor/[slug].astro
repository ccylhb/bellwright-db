---
const SITE = Astro.site?.origin ?? "";
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import armor from "../../data/bellwright_armor.json";
import mesh from "../../data/mesh.json";
import { introHtml } from "../../lib/mesh";
import { cl, pick, desc, stats, introSentence, best } from "../../lib/seo";

export function getStaticPaths() {
  return armor.map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props;
const f = x.fields || {};
const similar = armor
  .filter((o) => o.slug !== x.slug && (o.fields?.categ || o.fields?.category || "") === (f.categ || f.category || ""))
  .slice(0, 6);
const ihtml = introHtml(x.intro, mesh, x.title);
const __slug = Astro.params.slug;
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
      { "@type": "ListItem", position: 2, name: "Armor", item: SITE + "/armor/" },
      { "@type": "ListItem", position: 3, name: x.title },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: x.title,
    description: (x.intro || "").slice(0, 160),
    mainEntityOfPage: SITE + "/armor/" + __slug + "/",
  },
];

// SEO: lead with concrete stats; fall back to the scraped intro sentence.
const description =
  desc(
    `${x.title}:`,
    cl(f.categ) && cl(f.slot) && `${cl(f.categ)} ${cl(f.slot)} —`,
    stats(
      cl(f.armor) && `armor ${cl(f.armor)}`,
      cl(f.speed) && `speed ${cl(f.speed)}`,
      cl(f.weight) && `weight ${cl(f.weight)}`,
      cl(f.requs) && `requires ${cl(f.requs)}`
    ),
    "Bellwright armor stats."
  ) || introSentence(x.intro);
---
<Base
  title={`${x.title} — Bellwright armor stats`}
  description={description}
>
  <h1 class="icon-h1">
    {x.icon_file ? <img src={`/icons/${x.icon_file}`} alt={x.title} loading="eager" /> : null}
    <span>{x.title}</span>
  </h1>
  {ihtml && <p set:html={ihtml}></p>}
  <EntryStats entry={x} keys={["armor", "speed", "slot", "categ", "requs"]} labels={{ armor: "Armor", speed: "Speed", slot: "Slot", categ: "Category", requs: "Required skill level" }} />
  <Related
    links={[
      ...similar.map((s) => ({
        href: `/armor/${s.slug}/`,
        title: s.title,
        icon: s.icon_file ? `/icons/${s.icon_file}` : undefined,
      })),
      { href: "/armor/", title: "All Armor & Clothing", sub: "Sortable table" },
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
