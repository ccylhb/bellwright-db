---
const SITE = Astro.site?.origin ?? "";
import Base from "../../layouts/Base.astro";
import DataTable from "../../components/DataTable.astro";
import Related from "../../components/Related.astro";
import food from "../../data/bellwright_food.json";

const n = (v) => {
  const m = String(v ?? "").match(/-?\d+(?:\.\d+)?/);
  return m ? parseFloat(m[0]) : "";
};
const rows = food
  .map((x) => ({
    name: `<a href="/food/${x.slug}/">${x.title}</a>${x.icon_file ? ` <img src="/icons/${x.icon_file}" alt="" width="22" height="22" style="vertical-align:middle" loading="lazy" />` : ""}`,
    _sort: x.title.toLowerCase(),
    health: (x.fields?.health || "").slice(0, 10),
    stamina: (x.fields?.stamina || "").slice(0, 10),
    satiating: (x.fields?.satiating || "").slice(0, 10),
    regen: (x.fields?.regen_heath || "").slice(0, 10),
    category: (x.fields?.category || "").slice(0, 14),
  }))
  .sort((a, b) => a._sort.localeCompare(b._sort));
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
      { "@type": "ListItem", position: 2, name: "Food", item: SITE + "/food/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Food",
    mainEntityOfPage: SITE + "/food/",
  },
];

---
<Base
  title="Bellwright Food — ${food.length} entries with exact values"
  description="health, stamina and satiation values for ${food.length} Bellwright food."
>
  <h1>Food</h1>
  <p class="muted">${food.length} entries · click a column to sort.</p>
  <DataTable
    id="food"
    rows={rows}
    searchPlaceholder="Search food..."
    columns={[
      { key: "name", label: "Food" },
      { key: "health", label: "Health" },
      { key: "stamina", label: "Stamina" },
      { key: "satiating", label: "Satiating" },
      { key: "regen", label: "HP regen" },
      { key: "category", label: "Category" },
    ]}
  />
  <Related
    links={[
      { href: "/rankings/", title: "Rankings", sub: "Best food" },
      { href: "/armor/", title: "Armor", sub: "Armor values" },
      { href: "/tools/", title: "Tools & Resources", sub: "Gathering gear" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
