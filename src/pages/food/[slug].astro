---
const SITE = Astro.site?.origin ?? "";
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import food from "../../data/bellwright_food.json";
import mesh from "../../data/mesh.json";
import { introHtml } from "../../lib/mesh";
import { cl, pick, desc, stats, introSentence, best } from "../../lib/seo";

export function getStaticPaths() {
  return food.map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props;
const f = x.fields || {};
const similar = food
  .filter((o) => o.slug !== x.slug && (o.fields?.categ || o.fields?.category || "") === (f.categ || f.category || ""))
  .slice(0, 6);
const ihtml = introHtml(x.intro, mesh, x.title);
const __slug = Astro.params.slug;
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
      { "@type": "ListItem", position: 2, name: "Food", item: SITE + "/food/" },
      { "@type": "ListItem", position: 3, name: x.title },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: x.title,
    description: (x.intro || "").slice(0, 160),
    mainEntityOfPage: SITE + "/food/" + __slug + "/",
  },
];

// SEO: this board has no numeric infobox fields, so the scraped intro sentence
// is the best available answer; fall back to a topic sentence.
const description = best(
  x.intro,
  desc(`${x.title}:`, "Bellwright food item — nutrition, effects, and how to obtain it."),
  30
);
---
<Base
  title={`${x.title} — Bellwright food stats`}
  description={description}
>
  <h1 class="icon-h1">
    {x.icon_file ? <img src={`/icons/${x.icon_file}`} alt={x.title} loading="eager" /> : null}
    <span>{x.title}</span>
  </h1>
  {ihtml && <p set:html={ihtml}></p>}
  <EntryStats entry={x} keys={["health", "regen_heath", "stamina", "regen_stamina", "satiating", "skill_exp", "category"]} labels={{ health: "Health", regen_heath: "HP regen", stamina: "Stamina", regen_stamina: "Stamina regen", satiating: "Satiating", skill_exp: "Skill EXP", category: "Category" }} />
  <Related
    links={[
      ...similar.map((s) => ({
        href: `/food/${s.slug}/`,
        title: s.title,
        icon: s.icon_file ? `/icons/${s.icon_file}` : undefined,
      })),
      { href: "/food/", title: "All Food", sub: "Sortable table" },
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
