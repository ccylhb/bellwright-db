---
const SITE = Astro.site?.origin ?? "";
import Base from "../../layouts/Base.astro";
import DataTable from "../../components/DataTable.astro";
import Related from "../../components/Related.astro";
import tools from "../../data/bellwright_tools.json";

const n = (v) => {
  const m = String(v ?? "").match(/-?\d+(?:\.\d+)?/);
  return m ? parseFloat(m[0]) : "";
};
const rows = tools
  .map((x) => ({
    name: `<a href="/tools/${x.slug}/">${x.title}</a>${x.icon_file ? ` <img src="/icons/${x.icon_file}" alt="" width="22" height="22" style="vertical-align:middle" loading="lazy" />` : ""}`,
    _sort: x.title.toLowerCase(),
    category: (x.fields?.category || x.fields?.categ || "").slice(0, 16),
  }))
  .sort((a, b) => a._sort.localeCompare(b._sort));
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
      { "@type": "ListItem", position: 2, name: "Tools", item: SITE + "/tools/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Tools",
    mainEntityOfPage: SITE + "/tools/",
  },
];

---
<Base
  title="Bellwright Tools & Resources — ${tools.length} entries with exact values"
  description="tools, resources and seeds for ${tools.length} Bellwright tools & resources."
>
  <h1>Tools & Resources</h1>
  <p class="muted">${tools.length} entries · click a column to sort.</p>
  <DataTable
    id="tools"
    rows={rows}
    searchPlaceholder="Search tools & resources..."
    columns={[
      { key: "name", label: "Item" },
      { key: "category", label: "Category" },
    ]}
  />
  <Related
    links={[
      { href: "/food/", title: "Food", sub: "Health & stamina" },
      { href: "/weapons/", title: "Weapons", sub: "Damage values" },
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
